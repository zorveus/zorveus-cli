{
  "version": 1,
  "app": {
    "id": "app_documents",
    "name": "Document processor",
    "allowedModels": [
      "<openai-model-id>"
    ]
  },
  "providerCredentials": {
    "primary": {
      "id": "credential_primary",
      "name": "Primary provider account",
      "provider": "openai",
      "secretFromEnv": "OPENAI_API_KEY",
      "routingMode": "auto_resolve",
      "defaultModelPolicy": [
        "<openai-model-id>"
      ]
    }
  },
  "keys": {
    "processor": {
      "id": "key_processor",
      "name": "Processing backend",
      "creditMode": "enforce",
      "cap": {
        "amount": "50",
        "currency": "USD",
        "period": "monthly"
      }
    }
  }
}
