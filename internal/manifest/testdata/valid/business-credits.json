{
  "version": 1,
  "app": {
    "id": "app_business",
    "name": "Business assistant",
    "allowedModels": [
      "<model-id>"
    ],
    "creditUnitsPerUsd": "1000",
    "productUserChargeMultiplier": "2"
  },
  "keys": [
    {
      "id": "key_starter",
      "name": "Starter plan",
      "routingAlias": "starter",
      "creditMode": "enforce",
      "overrunPolicy": "limit_output",
      "cap": {
        "amount": "5",
        "currency": "USD",
        "period": "monthly"
      }
    },
    {
      "id": "key_business",
      "name": "Business plan",
      "routingAlias": "business",
      "creditMode": "enforce",
      "overrunPolicy": "carry_overrun_forward",
      "productUserChargeMultiplier": "1.5",
      "cap": {
        "amount": "25",
        "currency": "USD",
        "period": "monthly"
      }
    }
  ],
  "routingKeys": [
    {
      "id": "key_primary_router",
      "name": "Primary backend",
      "members": [
        "starter",
        "business"
      ],
      "defaultSelector": null
    },
    {
      "id": "key_business_router",
      "name": "Business integration",
      "members": [
        "business"
      ],
      "defaultSelector": "business"
    }
  ],
  "serviceKeys": [
    {
      "id": "service_key_billing",
      "name": "Billing backend",
      "scopes": [
        "product_users:read",
        "product_users:write"
      ]
    }
  ]
}
