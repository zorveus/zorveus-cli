{
  "version": 1,
  "app": {
    "id": "app_business",
    "name": "Business assistant",
    "allowedModels": [
      "<model-id>"
    ],
    "creditUnitsPerUsd": "1000",
    "productUserChargeMultiplier": "2"
  },
  "keys": {
    "starter": {
      "id": "key_starter",
      "name": "Starter plan",
      "creditMode": "enforce",
      "overrunPolicy": "limit_output",
      "cap": {
        "amount": "5",
        "currency": "USD",
        "period": "monthly"
      }
    },
    "business": {
      "id": "key_business",
      "name": "Business plan",
      "creditMode": "enforce",
      "overrunPolicy": "carry_overrun_forward",
      "productUserChargeMultiplier": "1.5",
      "cap": {
        "amount": "25",
        "currency": "USD",
        "period": "monthly"
      }
    }
  },
  "routingKeys": {
    "public": {
      "id": "key_primary_router",
      "name": "Primary backend",
      "members": [
        "starter",
        "business"
      ],
      "defaultSelector": null
    },
    "public_2": {
      "id": "key_business_router",
      "name": "Business integration",
      "members": [
        "business"
      ],
      "defaultSelector": "business"
    }
  },
  "serviceKeys": {
    "backend": {
      "id": "service_key_billing",
      "name": "Billing backend",
      "scopes": [
        "product_users:read",
        "product_users:write"
      ]
    }
  }
}
